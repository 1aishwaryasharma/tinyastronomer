{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinyastronomer",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
