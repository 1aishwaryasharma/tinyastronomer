context platform=android
open "Chrome" "http://10.0.2.2:8765/" --relaunch
wait "id=\"launch-title\"" 20000
wait "text" "Choose an observation" 20000
press "id=\"launch-light-study\""
wait "id=\"light-study-header\"" 20000
press "id=\"scene-nav-btn\""
wait "id=\"scene-menu\"" 10000
press "id=\"scene-next\""
wait "id=\"seasons-header\"" 20000
close
