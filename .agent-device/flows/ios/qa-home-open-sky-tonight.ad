context platform=ios
open "Safari" "http://127.0.0.1:8765/" --relaunch
wait "text" "Choose an observation" 20000
gesture "fling" "up" 195 640 280
wait "label=\"Sky Tonight\"" 10000
press "role=\"link\" label=\"Sky Tonight\" || label=\"Sky Tonight\""
wait "text" "What's in the Sky Tonight?" 20000
wait "label=\"Sky Tonight, banner\"" 10000

close
