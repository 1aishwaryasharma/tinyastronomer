context platform=ios
open "Safari" "http://127.0.0.1:8765/" --relaunch
wait "text" "Choose an observation" 20000
gesture "fling" "up" 195 640 280
wait "label=\"Missions\"" 10000
press "role=\"link\" label=\"Missions\" || label=\"Missions\""
wait "text" "Spacecraft & Missions" 20000
wait "label=\"Missions, banner\"" 10000

close
