context platform=ios
open "Safari" "http://127.0.0.1:8765/" --relaunch
wait "text" "Choose an observation" 20000
gesture "fling" "up" 195 640 280
wait "label=\"Seasons\"" 10000
press "role=\"link\" label=\"Seasons\" || label=\"Seasons\""
wait "text" "Why We Have Seasons" 20000
wait "label=\"Seasons controls, banner\"" 10000

close
