context platform=ios
open "Safari" "http://127.0.0.1:8765/" --relaunch
wait "text" "Choose an observation" 20000
gesture "fling" "up" 195 640 280
wait "label=\"Scale Walk\"" 10000
press "role=\"link\" label=\"Scale Walk\" || label=\"Scale Walk\""
wait "text" "How Far Apart?" 20000
wait "label=\"Scale Walk controls, banner\"" 10000

close
