# 'wasm-unsafe-eval' lets the vendored Meshopt decoder (planet models)
# compile its WebAssembly. It permits WebAssembly only; inline and eval'd
# JavaScript stay governed by the hash list below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-6RkvnLhc+Dxs3DRMSy+Rs0us73msKNskVUvxIBn7gdw=' 'sha256-EYLELQZbOflg/pGIA3QzvdJ5sC9IWYnb+ol4+bxQz1g=' 'sha256-9qbqiVAU84Xv3fjXYLJG5xDKmKNJah8LkA0c9DKt5ms=' 'sha256-DrcomQV3ZjLlrF6mLEQyOpz3Ip2c8NO2ciUHeBfBtWs=' 'sha256-1zggV6o4fRs3j5ApzE06SGOc1JjFvnTz1OoHVkfgedE=' 'sha256-HiLVOshfH2vV4DqagdpdI+34c2ymIWJVJaWbeutLnPI=' 'sha256-p6nJar47b80epm00v4AZrlrs+sRYOSSWxeLwXkqYRCY=' 'sha256-RhMfjJUYY+tzMgOsMTuDrpYWHBsE3eCSBdzh4+6ryWA='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'; manifest-src 'self'; media-src 'self'; worker-src 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Google crawls script, stylesheet, and vendor files to render pages and then
# reports them as "Crawled - currently not indexed". They are not pages;
# say so, so they drop out of the report rather than compete for crawl budget.
# (X-Robots-Tag does not stop Googlebot fetching them for rendering.)
/*.js
  X-Robots-Tag: noindex
/*.css
  X-Robots-Tag: noindex
/vendor/*
  X-Robots-Tag: noindex

# The branded not-found page is served for unknown paths with a 404 status;
# at its own address it would be an indexable 200, so keep it out of search.
/404
  X-Robots-Tag: noindex
